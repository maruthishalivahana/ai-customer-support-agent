# ==============================================================================
# Hiver AI Customer Support Agent - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# MongoDB Connection
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=hiver_support

# OpenRouter LLM Configuration (Phase 7)
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Retrieval & Escalation Thresholds
TOP_K_RETRIEVAL=3
MIN_RETRIEVAL_SCORE=0.65
MIN_INTENT_CONFIDENCE=0.70
